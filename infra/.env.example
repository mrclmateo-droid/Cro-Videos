# --- Base de datos / cola ---
DATABASE_URL=postgresql+psycopg://reelforge:reelforge@postgres:5432/reelforge
REDIS_URL=redis://redis:6379/0

# --- Storage S3-compatible (MinIO en local) ---
S3_ENDPOINT_INTERNAL=http://minio:9000
S3_ENDPOINT_PUBLIC=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=reelforge

# --- LLM (análisis de highlights) ---
LLM_PROVIDER=anthropic
# >>> PEGÁ TU CLAVE ACÁ <<<
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Transcripción local (faster-whisper) ---
# tiny/base = rápido en CPU. small/medium = mejor calidad, mucho más lento.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- API ---
CORS_ORIGINS=*
